<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Board</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header class="navbar">
        <div class="container nav-flex">
            <a href="/offres" class="logo">
                Job<span>Board</span>
            </a>

            <nav>
                <a href="/offres" class="nav-link active">Offres</a>
            </nav>
        </div>
    </header>

    <main class="container page-main">
        <a href="/offres" class="back-link">← Retour aux offres</a>

        <article class="job-card job-card-lg">

            <div class="card-header">
                <div>
                    <span class="badge">
                        <%= offre.typeContrat %>
                    </span>

                    <h1 class="card-header-title">
                        <%= offre.titre %>
                    </h1>

                    <p class="company ">
                        <%= offre.entreprise %> • <%= offre.ville %>
                    </p>
                </div>
            </div>


            <div class="job-details-content">

                <h3>Description du poste</h3>
                <p>
                    <%= offre.descriptionLongue %>
                </p>

                <h3>Profil recherché</h3>
                <p>
                    <%= offre.profilRecherche %>
                </p>

                <h3>Technologies requises</h3>
                <div class="tags">
                    <% offre.technologies.forEach(technology=> { %>
                        <span class="tag">
                            <%= technology %>
                        </span>
                        <% }); %>
                </div>

            </div>

            <div class="card-footer card-footer-clean">
                <small>
                    Publié le <%= offre.datePublication %>
                </small>
            </div>

        </article>
    </main>
</body>
</html> 